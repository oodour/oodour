# Editor configuration, see http://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false

# The distributed plugin's Markdown wraps at 120 columns; Prettier reads the width from here.
[plugins/**.md]
max_line_length = 120
