{
  "name": "fallow-config-lz-oop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/fallow-config-lz-oop/src",
  "targets": {
    "typecheck": {
      "command": "tsc -p packages/fallow-config-lz-oop/tsconfig.json",
      "inputs": ["default", { "externalDependencies": ["typescript", "@types/node", "ajv"] }]
    },
    "lint": {
      "command": "eslint packages/fallow-config-lz-oop",
      "inputs": ["default", "eslintConfig", { "externalDependencies": ["@types/node", "ajv"] }]
    },
    "test": {
      "command": "node --test \"packages/fallow-config-lz-oop/src/**/*.test.ts\"",
      "cache": true,
      "inputs": ["default", { "externalDependencies": ["ajv"] }, { "runtime": "node --version" }],
      "outputs": []
    },
    "pack": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node -e \"require('node:fs').mkdirSync('dist/packages', { recursive: true })\"",
          "npm pack ./packages/fallow-config-lz-oop --pack-destination dist/packages"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/packages/layzee-fallow-config-lz-oop-*.tgz"]
    }
  }
}
