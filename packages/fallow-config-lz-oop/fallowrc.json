{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/v3.43.2/schema.json",
  "minimumVersion": "3.43.2",
  "rules": {
    "complexity-cyclomatic": "error",
    "complexity-cognitive": "error",
    "complexity-crap": "error"
  },
  "health": {
    "maxCyclomatic": 4,
    "maxCognitive": 4,
    "changeCoupling": {
      "minDegree": 0.4
    }
  },
  "duplicates": {
    "ignore": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**", "**/test/**", "**/tests/**", "**/spec/**", "**/e2e/**"]
  },
  "overrides": [
    {
      "files": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**", "**/test/**", "**/tests/**", "**/spec/**", "**/e2e/**"],
      "rules": {
        "complexity-crap": "off"
      }
    }
  ]
}
