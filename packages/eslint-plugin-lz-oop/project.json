{
  "name": "eslint-plugin-lz-oop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/eslint-plugin-lz-oop/src",
  "namedInputs": {
    "ruleDependencies": [
      {
        "externalDependencies": [
          "typescript",
          "eslint",
          "typescript-eslint",
          "@typescript-eslint/utils",
          "@typescript-eslint/rule-tester",
          "@typescript-eslint/eslint-plugin",
          "@eslint-community/eslint-plugin-eslint-comments",
          "eslint-plugin-unicorn",
          "eslint-plugin-sonarjs",
          "eslint-plugin-functional"
        ]
      }
    ]
  },
  "targets": {
    "typecheck": {
      "command": "tsc -p packages/eslint-plugin-lz-oop/tsconfig.json",
      "inputs": ["default", "ruleDependencies", { "externalDependencies": ["@types/node"] }]
    },
    "lint": {
      "command": "eslint packages/eslint-plugin-lz-oop",
      "inputs": ["default", "eslintConfig", "ruleDependencies", { "externalDependencies": ["@types/node"] }]
    },
    "test": {
      "command": "node --test \"packages/eslint-plugin-lz-oop/src/**/*.test.ts\"",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/plugins/lz-oop/references/*.md",
        "ruleDependencies",
        { "runtime": "node --version" }
      ],
      "outputs": []
    },
    "mutate": {
      "command": "node --conditions=@layzee/source node_modules/@stryker-mutator/core/bin/stryker.js run stryker.eslint-plugin-lz-oop.config.ts",
      "cache": false,
      "parallelism": false
    }
  }
}
