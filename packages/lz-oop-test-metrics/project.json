  "projectType": "library",
  "sourceRoot": "packages/lz-oop-test-metrics/src",
  "targets": {
    "typecheck": {
      "command": "tsc -p packages/lz-oop-test-metrics/tsconfig.json",
      "inputs": ["default", { "externalDependencies": ["typescript", "@types/node"] }]
    },
    "lint": {
      "command": "eslint packages/lz-oop-test-metrics",
      "inputs": ["default", "eslintConfig", { "externalDependencies": ["@types/node"] }]
