{
  "name": "lz-oop-test-metrics",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/lz-oop-test-metrics/src",
  "targets": {
    "typecheck": {
      "command": "tsc -p packages/lz-oop-test-metrics/tsconfig.json",
      "inputs": [
        "default",
        { "externalDependencies": ["typescript", "@types/node", "eslint", "@typescript-eslint/parser", "vitest"] }
      ]
    },
    "lint": {
      "command": "eslint packages/lz-oop-test-metrics",
      "inputs": [
        "default",
        "eslintConfig",
        { "externalDependencies": ["@types/node", "eslint", "@typescript-eslint/parser", "vitest"] }
      ]
    },
    "test": {
      "command": "node --test \"packages/lz-oop-test-metrics/src/**/*.test.ts\"",
      "cache": true,
      "inputs": [
        "default",
        {
          "externalDependencies": [
            "eslint",
            "@typescript-eslint/parser",
            "typescript",
            "vitest",
            "@vitest/coverage-v8",
            "@vitest/coverage-istanbul"
          ]
        },
        { "runtime": "node --version" }
      ],
      "outputs": []
    }
  }
}
