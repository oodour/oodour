{
  "name": "eslint-plugin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/eslint-plugin/src",
  "namedInputs": {
    "ruleDependencies": [
      {
        "externalDependencies": [
          "typescript",
          "eslint",
          "typescript-eslint",
          "@typescript-eslint/utils",
          "@typescript-eslint/rule-tester",
          "@typescript-eslint/eslint-plugin",
          "@eslint-community/eslint-plugin-eslint-comments",
          "eslint-plugin-unicorn",
          "eslint-plugin-sonarjs",
          "eslint-plugin-functional"
        ]
      }
    ]
  },
  "targets": {
    "typecheck": {
      "command": "tsc -p packages/eslint-plugin/tsconfig.json",
      "inputs": ["default", "^default", "ruleDependencies", { "externalDependencies": ["@types/node"] }]
    },
    "lint": {
      "command": "eslint packages/eslint-plugin",
      "inputs": ["default", "^default", "eslintConfig", "ruleDependencies", { "externalDependencies": ["@types/node"] }]
    },
    "test": {
      "command": "node --conditions=@oodour/source --test \"packages/eslint-plugin/src/**/*.test.ts\"",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/plugins/oodour/references/*.md",
        "ruleDependencies",
        { "runtime": "node --version" }
      ],
      "outputs": []
    },
    "build": {
      "command": "tsc -p packages/eslint-plugin/tsconfig.build.json",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "ruleDependencies", { "externalDependencies": ["@types/node"] }],
      "outputs": ["{projectRoot}/dist"]
    },
    "pack": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node -e \"require('node:fs').mkdirSync('dist/packages', { recursive: true })\"",
          "npm pack ./packages/eslint-plugin --pack-destination dist/packages"
        ],
        "parallel": false
      },
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/packages/oodour-eslint-plugin-*.tgz"]
    },
    "mutate": {
      "command": "node --conditions=@oodour/source --conditions=@layzee/source node_modules/@stryker-mutator/core/bin/stryker.js run stryker.eslint-plugin.config.ts",
      "cache": false,
      "parallelism": false
    }
  }
}
