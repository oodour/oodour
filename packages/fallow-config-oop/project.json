{
  "name": "fallow-config-oop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/fallow-config-oop/src",
  "targets": {
    "typecheck": {
      "command": "tsc -p packages/fallow-config-oop/tsconfig.json",
      "inputs": ["default", { "externalDependencies": ["typescript", "@types/node", "ajv"] }]
    },
    "lint": {
      "command": "eslint packages/fallow-config-oop"
    },
    "test": {
      "command": "node --test \"packages/fallow-config-oop/src/**/*.test.ts\"",
      "cache": true,
      "inputs": ["default", { "externalDependencies": ["ajv"] }, { "runtime": "node --version" }],
      "outputs": []
    }
  }
}
