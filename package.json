{
  "name": "lz-oop-tooling",
  "private": true,
  "type": "module",
  "description": "Type-check, lint and test the oracle firewall's hooks, mod and tools.",
  "scripts": {
    "test:stryker": "node --test --test-skip-pattern=\"the real store\" \"*.test.ts\" \".claude/hooks/*.test.ts\" \"tools/*.test.ts\" \"tools/nx/*.test.ts\" \".claude/mods/oracle-scrub/.node-test/*.test.ts\"",
    "check": "nx run-many -t typecheck lint test test-mods validate overlap"
  },
  "nx": {
    "includedScripts": []
  },
  "devDependencies": {
    "@nx/devkit": "24.0.6",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "jiti": "2.6.1",
    "nx": "24.0.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
