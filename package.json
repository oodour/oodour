{
  "name": "oodour-tooling",
  "private": true,
  "type": "module",
  "description": "Type-check, lint and test the oracle firewall's hooks, mod and tools.",
  "scripts": {
    "check": "nx run-many -t typecheck lint test test-mods validate overlap citations && nx format:check --all",
    "check:ci": "nx run-many -t typecheck lint test test-mods validate citations --configuration=ci && nx format:check --all"
  },
  "workspaces": [
    "packages/*"
  ],
  "nx": {
    "includedScripts": []
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@nx/devkit": "24.0.6",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/rule-tester": "8.72.1",
    "@typescript-eslint/utils": "8.72.1",
    "@vitest/coverage-istanbul": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "80.0.0",
    "ignore": "7.0.14",
    "jiti": "2.6.1",
    "nx": "24.0.6",
    "prettier": "~3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
