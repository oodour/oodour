{
  "name": "lz-oop-tooling",
  "private": true,
  "type": "module",
  "description": "Type-check, lint and test the oracle firewall's hooks, mod and tools.",
  "scripts": {
    "test:stryker": "node --test --test-skip-pattern=\"the real (store|eval cases)\" \"*.test.ts\" \".claude/hooks/*.test.ts\" \"tools/*.test.ts\" \"tools/nx/*.test.ts\" \".claude/mods/oracle-scrub/.node-test/*.test.ts\" \".claude/mods/oracle-guard/.node-test/*.test.ts\"",
    "check": "nx run-many -t typecheck lint test test-mods validate overlap citations && nx format:check --all"
  },
  "nx": {
    "includedScripts": []
  },
  "devDependencies": {
    "@nx/devkit": "24.0.6",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/rule-tester": "8.72.1",
    "@typescript-eslint/utils": "8.72.1",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "80.0.0",
    "jiti": "2.6.1",
    "nx": "24.0.6",
    "prettier": "~3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
