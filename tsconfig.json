{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "customConditions": ["@oodour/source"],
    "lib": ["es2025"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": [
    ".claude/hooks/**/*.ts",
    ".claude/mods/oracle-scrub/hooks/scrub.ts",
    ".claude/mods/oracle-scrub/.node-test/*.ts",
    ".claude/mods/oracle-guard/hooks/decide.ts",
    ".claude/mods/oracle-guard/hooks/paths.ts",
    ".claude/mods/oracle-guard/.node-test/*.ts",
    "tools/**/*.ts",
    "*.test.ts",
    "eslint.config.ts",
    "stryker.config.ts",
    "stryker.*.config.ts",
    "stryker.shared.ts"
  ],
  "exclude": ["node_modules", ".oracle"]
}
