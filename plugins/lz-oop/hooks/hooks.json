{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*lz-oop.ts*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/trust-gate.ts"],
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(*lz-oop.ts*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/trust-gate.ts"],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
