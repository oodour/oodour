{
  "name": "tooling",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/.claude/hooks/**/*",
      "{projectRoot}/.claude/mods/**/*",
      "{projectRoot}/.claude/settings.json",
      "{projectRoot}/tools/**/*",
      "{projectRoot}/*.ts",
      "{projectRoot}/package.json",
      "sharedGlobals"
    ]
  },
  "targets": {
    "typecheck": {
      "command": "tsc -p tsconfig.json && tsc -p .claude/mods/oracle-scrub && tsc -p .claude/mods/oracle-scrub/.node-test && tsc -p .claude/mods/oracle-guard && tsc -p .claude/mods/oracle-guard/.node-test",
      "inputs": [
        "default",
        {
          "externalDependencies": [
            "typescript",
            "@types/node",
            "@nx/devkit",
            "@stryker-mutator/core",
            "@stryker-mutator/api",
            "typescript-eslint"
          ]
        },
        { "runtime": "claude --version" }
      ]
    },
    "lint": {
      "command": "eslint . --ignore-pattern \"packages/\" --ignore-pattern \"plugins/\"",
      "inputs": [
        "default",
        "eslintConfig",
        { "externalDependencies": ["@types/node", "@nx/devkit", "@stryker-mutator/core", "@stryker-mutator/api"] },
        { "runtime": "claude --version" }
      ]
    },
    "test": {
      "command": "node --test \"*.test.ts\" \".claude/hooks/*.test.ts\" \"tools/*.test.ts\" \"tools/nx/*.test.ts\" \".claude/mods/oracle-scrub/.node-test/*.test.ts\" \".claude/mods/oracle-guard/.node-test/*.test.ts\"",
      "cache": false
    },
    "test-mods": {
      "command": "claude plugin validate .claude/mods/oracle-scrub && claude plugin test .claude/mods/oracle-scrub && claude plugin validate .claude/mods/oracle-guard && claude plugin test .claude/mods/oracle-guard",
      "cache": true,
      "inputs": ["{projectRoot}/.claude/mods/**/*", { "runtime": "claude --version" }],
      "outputs": []
    },
    "mutate": {
      "command": "node --conditions=@oodour/source node_modules/@stryker-mutator/core/bin/stryker.js run stryker.config.ts",
      "cache": false,
      "parallelism": false
    }
  }
}
